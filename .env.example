# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------
# Copy this file to ``.env`` and fill in your values.
# ---------------------------------------------------------------------------

BACKEND_URL=http://localhost:8000
DB_PATH=/db/sql_agent.db

# Tool-call log output directory (default: /logs)
LOG_DIR=./logs

# Frontend request timeout in seconds
REQUEST_TIMEOUT=600

# ---------------------------------------------------------------------------
# LLM connection configuration
# ---------------------------------------------------------------------------
# The backend uses langchain_openai.ChatOpenAI, so the endpoint must be
# OpenAI-compatible. This works for cloud providers and self-hosted servers
# alike (e.g. DeepSeek, Ollama with /v1, vLLM, LM Studio).
# ---------------------------------------------------------------------------

# Model identifier (e.g. deepseek-chat, llama3.1:8b)
LLM_MODEL=

# OpenAI-compatible base URL (e.g. https://api.deepseek.com/v1,
# http://localhost:11434/v1)
LLM_ENDPOINT=

# API key for the endpoint. Required even if the endpoint does not perform
# authentication; in that case use a dummy non-empty value such as "not-needed".
LLM_API_KEY=

# Additional keyword arguments for ChatOpenAI. Each variable starts with
# LLM_KWARGS__, the suffix is lower-cased and used as the kwarg name, and the
# value is JSON-decoded when possible.
LLM_KWARGS__TEMPERATURE=0.0
LLM_KWARGS__MAX_TOKENS=4096
LLM_KWARGS__TIMEOUT=60
LLM_KWARGS__MAX_RETRIES=2
# LLM_KWARGS__EXTRA_BODY={"thinking": {"type": "disabled"}}
