# ---------------------------------------------------------------------------
# LLM connection configuration
# ---------------------------------------------------------------------------
# Copy this file to ``.env`` and fill in your values.
# The ``.env`` file is read automatically by ``src/backend/utils/llm.py``.
# ---------------------------------------------------------------------------

# Common variables
BACKEND_URL=http://localhost:8000
DB_PATH=/db/sql_agent.db

# --- Cloud backend (DeepSeek) ---

# Model identifier (e.g. deepseek-chat, deepseek-reasoner)
CLOUD_MODEL=

# Base URL of the DeepSeek API endpoint
CLOUD_API_ENDPOINT=

# API key for DeepSeek authentication
CLOUD_API_KEY=

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
CLOUD_TEMPERATURE=

# Maximum tokens to generate in a single completion
CLOUD_MAX_TOKENS=

# Request timeout in seconds
CLOUD_TIMEOUT=

# Maximum retries on transient failures
CLOUD_MAX_RETRIES=

# --- Local backend (Ollama) ---

# Model identifier (e.g. llama3.1:8b, mistral:7b, qwen2.5:14b)
LOCAL_MODEL=

# Base URL of the Ollama API endpoint (default: http://localhost:11434)
LOCAL_API_ENDPOINT=

# API key for the local endpoint (leave empty if no auth is required)
LOCAL_API_KEY=

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LOCAL_TEMPERATURE=

# Maximum tokens to generate in a single completion
LOCAL_MAX_TOKENS=

# Request timeout in seconds
LOCAL_TIMEOUT=

# Maximum retries on transient failures (not forwarded to ChatOllama)
LOCAL_MAX_RETRIES=
